/node_modules
/oh_modules
/local.properties
/.idea
**/build
/.hvigor
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
/.build-third-party
/third_party
/.hometrans

# Signing config holds the real cert/key passwords — never commit it.
# Generate locally via DevEco auto-signing; see build-profile.json5.sample.
/build-profile.json5
/scripts/signing/*.json5

# Local dev tooling + AI assistant instructions — keep on disk, never in the repo.
/resume.sh
/CLAUDE.md

# Install-tree byproducts of scripts/build-third-party.sh. What's tracked is
# include/ + the .a files CMake actually links; bin/, share/, cmake/pkgconfig
# metadata and the duplicate sub-dep libs the engine installs next to
# libtransmission.a are build leftovers.
entry/src/main/cpp/third_party/*/bin/
entry/src/main/cpp/third_party/*/share/
entry/src/main/cpp/third_party/*/lib/cmake/
entry/src/main/cpp/third_party/*/lib/pkgconfig/
entry/src/main/cpp/third_party/transmission/lib/lib*.a
!entry/src/main/cpp/third_party/transmission/lib/libtransmission.a