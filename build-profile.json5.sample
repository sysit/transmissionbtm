// transmissionbtm — sanitized build-profile.json5 template.
//
// Do NOT commit the real build-profile.json5: it carries the signing
// certificate paths AND the debug keystore keyPassword/storePassword
// (see .gitignore's /build-profile.json5 rule). Regenerate a real one
// with DevEco Studio's automatic signing instead — it writes into
// ~/.ohos/config/<bundleName>__<hash>.{cer,p7b,p12} and fills the
// material block below. Replace every <...> placeholder before using.
{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/ABS/PATH/TO/<bundleName>__<hash>.cer",
          "keyAlias": "debugKey",
          "keyPassword": "<auto-generated debug keystore password - not committed>",
          "profile": "/ABS/PATH/TO/<bundleName>__<hash>.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/ABS/PATH/TO/<bundleName>__<hash>.p12",
          "storePassword": "<auto-generated debug keystore password - not committed>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
