#!/usr/bin/env bash
# transmissionbtm — hvigorw wrapper
# Delegates to DevEco Studio bundled hvigor (v6.24.3) + Node (v18.20.1).

DEVECO_HOME="/Applications/DevEco-Studio.app/Contents"
HVIGOR_HOME="${DEVECO_HOME}/tools/hvigor"
NODE_HOME="${DEVECO_HOME}/tools/node"

export NODE_HOME
exec "${NODE_HOME}/bin/node" "${HVIGOR_HOME}/bin/hvigorw.js" "$@"
